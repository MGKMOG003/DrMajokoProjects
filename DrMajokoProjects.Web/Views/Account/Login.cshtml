@model DrMajokoProjects.Web.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-primary text-white text-center">
                <h3 class="mb-0">🔐 Login</h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text">📧</span>
                            <input asp-for="Email" class="form-control" placeholder="your.email@example.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text">🔒</span>
                            <input asp-for="Password" class="form-control" placeholder="Enter your password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">
                            Remember me
                        </label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </button>
                    </div>
                </form>

                <hr class="my-4" />

                <div class="text-center">
                    <p class="mb-0">Don't have an account?</p>
                    <a asp-action="Register" class="btn btn-outline-success">
                        Register Now
                    </a>
                </div>
            </div>
        </div>

        <!-- Quick Login Guide -->
        <div class="card mt-3 bg-light">
            <div class="card-body">
                <h6 class="card-title">Quick Access (Demo)</h6>
                <small class="text-muted">
                    <strong>Admin:</strong> admin@drmajoko.com<br />
                    <strong>PM:</strong> pm@drmajoko.com<br />
                    <strong>Contractor:</strong> contractor@drmajoko.com<br />
                    <strong>Client:</strong> client@drmajoko.com<br />
                    <em>Password: password123</em>
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}