@model List<DrMajokoProjects.Web.Models.ViewModels.AuditLogViewModel>

@{
    ViewData["Title"] = "Audit Logs";
}

<h2>Audit Logs</h2>

<div class="row mb-3">
    <div class="col-12">
        <form asp-action="AuditLog" method="get" class="row g-3">
            <div class="col-md-3">
                <input type="date" name="startDate" class="form-control" placeholder="Start Date" value="@ViewBag.StartDate" />
            </div>
            <div class="col-md-3">
                <input type="date" name="endDate" class="form-control" placeholder="End Date" value="@ViewBag.EndDate" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a asp-action="AuditLog" class="btn btn-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity Type</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>@log.Timestamp.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@log.UserName</td>
                        <td>
                            <span class="badge bg-info">@log.Action</span>
                        </td>
                        <td>@log.EntityType</td>
                        <td>@log.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>