@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="row mb-4">
    <div class="col">
        <h2>👨‍💼 Admin Dashboard</h2>
        <p class="text-muted">System Overview and Management</p>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body text-center">
                <h6>Total Users</h6>
                <h2>@ViewBag.TotalUsers</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body text-center">
                <h6>Pending Approval</h6>
                <h2>@ViewBag.PendingUsers</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body text-center">
                <h6>Total Projects</h6>
                <h2>@ViewBag.TotalProjects</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body text-center">
                <h6>Active Projects</h6>
                <h2>@ViewBag.ActiveProjects</h2>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <div class="card h-100">
                            <div class="card-body text-center">
                                <h3>👥</h3>
                                <h5>User Management</h5>
                                <p class="text-muted">Approve or deny user registrations</p>
                                <a asp-action="AuthRole" class="btn btn-primary">
                                    Manage Users
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="card h-100">
                            <div class="card-body text-center">
                                <h3>🏗️</h3>
                                <h5>Projects</h5>
                                <p class="text-muted">View and manage all projects</p>
                                <a asp-action="Projects" class="btn btn-success">
                                    View Projects
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="card h-100">
                            <div class="card-body text-center">
                                <h3>📊</h3>
                                <h5>Reports</h5>
                                <p class="text-muted">System analytics and reports</p>
                                <a href="#" class="btn btn-info">
                                    View Reports
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>