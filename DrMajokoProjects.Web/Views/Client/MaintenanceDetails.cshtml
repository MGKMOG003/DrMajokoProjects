@model DrMajokoProjects.Web.Models.ViewModels.MaintenanceRequestViewModel

@{
    ViewData["Title"] = "Maintenance Request Details";
    var clientId = ViewBag.ClientId as string;
}

<div class="row mb-3">
    <div class="col">
        <h2>Maintenance Request Details</h2>
    </div>
    <div class="col text-end">
        <a asp-action="MyMaintenanceRequests" asp-route-clientId="@clientId" class="btn btn-secondary">Back to Requests</a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">@Model.Title</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Status:</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-@(Model.Status == "Completed" ? "success" : Model.Status == "In Progress" ? "primary" : "secondary")">
                            @Model.Status
                        </span>
                    </dd>

                    <dt class="col-sm-3">Priority:</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-@(Model.Priority == "Urgent" ? "danger" : Model.Priority == "High" ? "warning" : "info")">
                            @Model.Priority
                        </span>
                    </dd>

                    <dt class="col-sm-3">Description:</dt>
                    <dd class="col-sm-9">@Model.Description</dd>

                    <dt class="col-sm-3">Submitted:</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")</dd>

                    @if (Model.AssignedAt.HasValue)
                    {
                        <dt class="col-sm-3">Assigned:</dt>
                        <dd class="col-sm-9">@Model.AssignedAt.Value.ToString("dd MMMM yyyy HH:mm")</dd>
                    }

                    @if (Model.CompletedAt.HasValue)
                    {
                        <dt class="col-sm-3">Completed:</dt>
                        <dd class="col-sm-9">@Model.CompletedAt.Value.ToString("dd MMMM yyyy HH:mm")</dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.CompletionNotes))
                    {
                        <dt class="col-sm-3">Completion Notes:</dt>
                        <dd class="col-sm-9">@Model.CompletionNotes</dd>
                    }
                </dl>

                @if (Model.PhotoUrls != null && Model.PhotoUrls.Any())
                {
                    <hr />
                    <h5>Attached Photos</h5>
                    <div class="row">
                        @foreach (var photo in Model.PhotoUrls)
                        {
                            <div class="col-md-4 mb-3">
                                <img src="@photo" class="img-fluid img-thumbnail" alt="Maintenance photo" />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Timeline</h5>
            </div>
            <div class="card-body">
                <div class="timeline">
                    <div class="mb-3">
                        <span class="badge bg-success">✓</span>
                        <strong>Submitted</strong><br />
                        <small class="text-muted">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                    </div>

                    @if (Model.Status != "Pending")
                    {
                        <div class="mb-3">
                            <span class="badge bg-success">✓</span>
                            <strong>Assigned to Contractor</strong><br />
                            <small class="text-muted">@(Model.AssignedAt?.ToString("dd MMM yyyy HH:mm") ?? "In progress")</small>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <span class="badge bg-secondary">○</span>
                            <strong>Awaiting Assignment</strong><br />
                            <small class="text-muted">Pending</small>
                        </div>
                    }

                    @if (Model.Status == "In Progress")
                    {
                        <div class="mb-3">
                            <span class="badge bg-primary">⟳</span>
                            <strong>Work in Progress</strong><br />
                            <small class="text-muted">Current stage</small>
                        </div>
                    }

                    @if (Model.Status == "Completed")
                    {
                        <div class="mb-3">
                            <span class="badge bg-success">✓</span>
                            <strong>Completed</strong><br />
                            <small class="text-muted">@(Model.CompletedAt?.ToString("dd MMM yyyy HH:mm") ?? "")</small>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <span class="badge bg-secondary">○</span>
                            <strong>Completion</strong><br />
                            <small class="text-muted">Pending</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>