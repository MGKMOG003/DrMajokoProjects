@model List<DrMajokoProjects.Web.Models.ViewModels.MaintenanceRequestViewModel>

@{
    ViewData["Title"] = "Maintenance Requests";
}

<div class="row mb-3">
    <div class="col">
        <h2>Maintenance Requests</h2>
    </div>
    <div class="col text-end">
        <a asp-action="Create" class="btn btn-primary">Create New Request</a>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var request in Model)
            {
                <tr>
                    <td>@request.Title</td>
                    <td>
                        <span class="badge bg-@(request.Priority == "Urgent" ? "danger" : request.Priority == "High" ? "warning" : "info")">
                            @request.Priority
                        </span>
                    </td>
                    <td>
                        <span class="badge bg-@(request.Status == "Completed" ? "success" : "secondary")">
                            @request.Status
                        </span>
                    </td>
                    <td>@request.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td>
                        <a href="#" class="btn btn-sm btn-outline-primary">View</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">No maintenance requests found.</td>
            </tr>
        }
    </tbody>
</table>