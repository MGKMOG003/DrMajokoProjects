@model DrMajokoProjects.Web.Models.ViewModels.CreateTaskViewModel

@{
    ViewData["Title"] = "Create Task";
    var phase = ViewBag.Phase as DrMajokoProjects.Web.Models.ViewModels.PhaseViewModel;
    var contractors = ViewBag.Contractors as List<DrMajokoProjects.Web.Models.ViewModels.UserViewModel>;
    var phaseTasks = ViewBag.PhaseTasks as List<DrMajokoProjects.Web.Models.ViewModels.TaskViewModel>;
    var pmId = ViewBag.PMId as string;
    var projectId = ViewBag.ProjectId as string;
}

<div class="row">
    <div class="col-md-10 offset-md-1">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">Create Task in Phase: @phase.PhaseName</h3>
            </div>
            <div class="card-body">
                <form asp-action="CreateTask" method="post">
                    <input type="hidden" name="ProjectId" value="@projectId" />
                    <input type="hidden" name="PhaseId" value="@phase.Id" />

                    <div class="mb-3">
                        <label class="form-label">Task Name <span class="text-danger">*</span></label>
                        <input asp-for="TaskName" class="form-control" placeholder="e.g., Excavate foundation, Pour concrete" required />
                        <span asp-validation-for="TaskName" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Assigned Contractor <span class="text-danger">*</span></label>
                            <select asp-for="AssignedContractorId" class="form-select" required>
                                <option value="">-- Select Contractor --</option>
                                @foreach (var contractor in contractors)
                                {
                                    <option value="@contractor.Id">@contractor.Name - @contractor.Email</option>
                                }
                            </select>
                            <span asp-validation-for="AssignedContractorId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Priority <span class="text-danger">*</span></label>
                            <select asp-for="Priority" class="form-select" required>
                                <option value="Low">Low</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="High">High</option>
                                <option value="Urgent">Urgent</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Estimated Start Date <span class="text-danger">*</span></label>
                            <input asp-for="EstimatedStartDate" class="form-control" type="date" required />
                            <small class="text-muted">Phase: @phase.EstimatedStartDate.ToString("dd MMM yyyy")</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Estimated End Date <span class="text-danger">*</span></label>
                            <input asp-for="EstimatedEndDate" class="form-control" type="date" required />
                            <small class="text-muted">Phase: @phase.EstimatedEndDate.ToString("dd MMM yyyy")</small>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Estimated Cost (R)</label>
                            <input asp-for="EstimatedCost" class="form-control" type="number" step="0.01" min="0" />
                            <small class="text-muted">Phase Budget: R @phase.PhaseBudget.ToString("N2")</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Scheduled" selected>Scheduled</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Delayed">Delayed</option>
                                <option value="Done">Done</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Depends On Task (Optional)</label>
                        <select asp-for="DependsOnTaskId" class="form-select">
                            <option value="">-- No Dependency --</option>
                            @foreach (var task in phaseTasks)
                            {
                                <option value="@task.Id">@task.TaskName</option>
                            }
                        </select>
                        <small class="text-muted">This task will only start after the selected task is complete</small>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">Create Task</button>
                        <a asp-action="Timeline" asp-route-projectId="@projectId" asp-route-pmId="@pmId" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}