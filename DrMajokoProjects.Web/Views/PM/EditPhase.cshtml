@model DrMajokoProjects.Web.Models.ViewModels.PhaseViewModel

@{
    ViewData["Title"] = "Edit Phase";
    var pmId = ViewBag.PMId as string;
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">Edit Phase: @Model.PhaseName</h3>
            </div>
            <div class="card-body">
                <form asp-action="EditPhase" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ProjectId" />
                    <input type="hidden" asp-for="OrderIndex" />
                    <input type="hidden" asp-for="PhaseCost" />

                    <div class="mb-3">
                        <label class="form-label">Phase Name <span class="text-danger">*</span></label>
                        <input asp-for="PhaseName" class="form-control" required />
                        <span asp-validation-for="PhaseName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Phase Budget (R) <span class="text-danger">*</span></label>
                        <input asp-for="PhaseBudget" class="form-control" type="number" step="0.01" min="0" required />
                        <small class="text-muted">Currently spent: R @Model.PhaseCost.ToString("N2")</small>
                        <span asp-validation-for="PhaseBudget" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Estimated Start Date <span class="text-danger">*</span></label>
                            <input asp-for="EstimatedStartDate" class="form-control" type="date" required />
                            <span asp-validation-for="EstimatedStartDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Estimated End Date <span class="text-danger">*</span></label>
                            <input asp-for="EstimatedEndDate" class="form-control" type="date" required />
                            <span asp-validation-for="EstimatedEndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Actual Start Date</label>
                            <input asp-for="ActualStartDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Actual End Date</label>
                            <input asp-for="ActualEndDate" class="form-control" type="date" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Pending">Pending</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Done">Done</option>
                        </select>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-success btn-lg">Save Changes</button>
                        <a asp-action="Timeline" asp-route-projectId="@Model.ProjectId" asp-route-pmId="@pmId" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}