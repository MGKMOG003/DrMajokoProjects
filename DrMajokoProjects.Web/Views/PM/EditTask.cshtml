@model DrMajokoProjects.Web.Models.ViewModels.TaskViewModel

@{
    ViewData["Title"] = "Edit Task";
    var contractors = ViewBag.Contractors as List<DrMajokoProjects.Web.Models.ViewModels.UserViewModel>;
    var pmId = ViewBag.PMId as string;
}

<div class="row">
    <div class="col-md-10 offset-md-1">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">Edit Task: @Model.TaskName</h3>
            </div>
            <div class="card-body">
                <form asp-action="EditTask" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ProjectId" />
                    <input type="hidden" asp-for="PhaseId" />
                    <input type="hidden" asp-for="ActualCost" />

                    <div class="mb-3">
                        <label class="form-label">Task Name <span class="text-danger">*</span></label>
                        <input asp-for="TaskName" class="form-control" required />
                        <span asp-validation-for="TaskName" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Assigned Contractor <span class="text-danger">*</span></label>
                            <select asp-for="AssignedContractorId" class="form-select" required>
                                <option value="">-- Select Contractor --</option>
                                @foreach (var contractor in contractors)
                                {
                                    <option value="@contractor.Id">@contractor.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Priority</label>
                            <select asp-for="Priority" class="form-select">
                                <option value="Low">Low</option>
                                <option value="Medium">Medium</option>
                                <option value="High">High</option>
                                <option value="Urgent">Urgent</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Estimated Start Date</label>
                            <input asp-for="EstimatedStartDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Estimated End Date</label>
                            <input asp-for="EstimatedEndDate" class="form-control" type="date" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Actual Start Date</label>
                            <input asp-for="ActualStartDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Actual End Date</label>
                            <input asp-for="ActualEndDate" class="form-control" type="date" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Estimated Cost (R)</label>
                            <input asp-for="EstimatedCost" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Scheduled">Scheduled</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Delayed">Delayed</option>
                                <option value="Done">Done</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Completion Notes</label>
                        <textarea asp-for="CompletionNotes" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-success btn-lg">Save Changes</button>
                        <a asp-action="Timeline" asp-route-projectId="@Model.ProjectId" asp-route-pmId="@pmId" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}