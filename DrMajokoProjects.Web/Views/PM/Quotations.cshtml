@model List<DrMajokoProjects.Web.Models.ViewModels.QuotationViewModel>

@{
    ViewData["Title"] = "Quotation Management";
    var project = ViewBag.Project as DrMajokoProjects.Web.Models.ViewModels.ProjectViewModel;
    var pmId = ViewBag.PMId as string;
}

<div class="row mb-3">
    <div class="col">
        <h2>💰 Quotation Management: @project.Name</h2>
    </div>
    <div class="col text-end">
        <a asp-action="Timeline" asp-route-projectId="@project.Id" asp-route-pmId="@pmId" class="btn btn-secondary">
            ← Back to Timeline
        </a>
    </div>
</div>

<!-- Quotation Summary -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <h6>Pending Review</h6>
                <h3>@Model.Count(q => q.Status == "Submitted")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h6>Approved</h6>
                <h3>@Model.Count(q => q.Status == "Approved")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-danger text-white">
            <div class="card-body">
                <h6>Rejected</h6>
                <h3>@Model.Count(q => q.Status == "Rejected")</h3>
            </div>
        </div>
    </div>
</div>

<!-- Quotations List -->
@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Task</th>
                        <th>Contractor</th>
                        <th>Amount</th>
                        <th>Material</th>
                        <th>Labor</th>
                        <th>Submitted</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var quotation in Model.OrderByDescending(q => q.SubmittedAt))
                    {
                        <tr class="@(quotation.Status == "Submitted" ? "table-warning" : "")">
                            <td><strong>@quotation.TaskName</strong></td>
                            <td>@quotation.ContractorName</td>
                            <td><strong>R @quotation.QuotationAmount.ToString("N2")</strong></td>
                            <td>R @quotation.MaterialCost.ToString("N2")</td>
                            <td>R @quotation.LaborCost.ToString("N2")</td>
                            <td>@quotation.SubmittedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge bg-@(quotation.Status == "Approved" ? "success" : quotation.Status == "Rejected" ? "danger" : "warning")">
                                    @quotation.Status
                                </span>
                            </td>
                            <td>
                                @if (quotation.Status == "Submitted")
                                {
                                    <form asp-action="ApproveQuotation" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@quotation.Id" />
                                        <input type="hidden" name="projectId" value="@project.Id" />
                                        <input type="hidden" name="pmId" value="@pmId" />
                                        <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Approve this quotation?')">
                                            ✓ Approve
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@quotation.Id">
                                        ✗ Reject
                                    </button>

                                    <!-- Reject Modal -->
                                    <div class="modal fade" id="rejectModal-@quotation.Id" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Reject Quotation</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <form asp-action="RejectQuotation" method="post">
                                                    <div class="modal-body">
                                                        <input type="hidden" name="id" value="@quotation.Id" />
                                                        <input type="hidden" name="projectId" value="@project.Id" />
                                                        <input type="hidden" name="pmId" value="@pmId" />
                                                        <div class="mb-3">
                                                            <label class="form-label">Reason for Rejection</label>
                                                            <textarea name="reason" class="form-control" rows="3" required></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-danger">Reject Quotation</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (quotation.Status == "Approved")
                                {
                                    <span class="text-success">✓ Approved</span>
                                }
                                else
                                {
                                    <span class="text-danger" title="@quotation.RejectionReason">✗ Rejected</span>
                                }
                            </td>
                        </tr>

                        <!-- Description Row -->
                        @if (!string.IsNullOrEmpty(quotation.Description))
                        {
                            <tr>
                                <td colspan="8" class="small text-muted">
                                    <strong>Description:</strong> @quotation.Description
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        No quotations submitted yet.
    </div>
}