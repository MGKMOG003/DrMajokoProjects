@model DrMajokoProjects.Web.Models.ViewModels.ProjectViewModel

@{
    ViewData["Title"] = "Project Details";
}

<div class="row mb-3">
    <div class="col">
        <h2>Project Details</h2>
    </div>
    <div class="col text-end">
        <a asp-controller="Admin" asp-action="EditProject" asp-route-id="@Model.Id" class="btn btn-warning">Edit Project</a>
        <a asp-controller="Admin" asp-action="Projects" class="btn btn-secondary">Back to Projects</a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">@Model.Name</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Description:</dt>
                    <dd class="col-sm-9">@(Model.Description ?? "No description provided")</dd>

                    <dt class="col-sm-3">Status:</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-@(Model.Status == "Completed" ? "success" : Model.Status == "In Progress" ? "primary" : Model.Status == "On Hold" ? "warning" : "secondary")">
                            @Model.Status
                        </span>
                    </dd>

                    <dt class="col-sm-3">Start Date:</dt>
                    <dd class="col-sm-9">@Model.StartDate.ToString("dd MMMM yyyy")</dd>

                    <dt class="col-sm-3">End Date:</dt>
                    <dd class="col-sm-9">@(Model.EndDate?.ToString("dd MMMM yyyy") ?? "Not set")</dd>

                    <dt class="col-sm-3">Client ID:</dt>
                    <dd class="col-sm-9">@Model.ClientId</dd>

                    <dt class="col-sm-3">Project Manager ID:</dt>
                    <dd class="col-sm-9">@Model.ProjectManagerId</dd>
                </dl>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Project Timeline</h5>
            </div>
            <div class="card-body">
                @if (Model.StartDate <= DateTime.Now && (!Model.EndDate.HasValue || Model.EndDate.Value >= DateTime.Now))
                {
                    <div class="alert alert-info">
                        <strong>In Progress:</strong> This project is currently active.
                    </div>
                }
                else if (Model.EndDate.HasValue && Model.EndDate.Value < DateTime.Now)
                {
                    <div class="alert alert-success">
                        <strong>Completed:</strong> This project has ended.
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <strong>Upcoming:</strong> This project has not started yet.
                    </div>
                }

                <p>
                    <strong>Duration:</strong>
                    @if (Model.EndDate.HasValue)
                    {
                        var duration = (Model.EndDate.Value - Model.StartDate).Days;
                        <span>@duration days</span>
                    }
                    else
                    {
                        <span>Ongoing</span>
                    }
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Budget Overview</h5>
            </div>
            <div class="card-body">
                <h3 class="text-success">R @Model.Budget.ToString("N2")</h3>
                <p class="text-muted mb-2">Total Budget</p>

                <h4 class="text-warning">R @Model.ActualSpent.ToString("N2")</h4>
                <p class="text-muted mb-2">Amount Spent</p>

                <h4 class="text-primary">R @((Model.Budget - Model.ActualSpent).ToString("N2"))</h4>
                <p class="text-muted mb-3">Remaining</p>

                @{
                    var percentSpent = Model.Budget > 0 ? (Model.ActualSpent / Model.Budget) * 100 : 0;
                }

                <div class="progress" style="height: 25px;">
                    <div class="progress-bar @(percentSpent > 90 ? "bg-danger" : percentSpent > 70 ? "bg-warning" : "bg-success")"
                         role="progressbar"
                         style="width: @percentSpent%">
                        @percentSpent.ToString("F1")%
                    </div>
                </div>
                <small class="text-muted">Budget utilization</small>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-controller="Maintenance" asp-action="Create" class="btn btn-outline-primary">
                        Add Maintenance Request
                    </a>
                    <a asp-controller="Admin" asp-action="OpenChat" asp-route-projectId="@Model.Id" class="btn btn-outline-info">
                        View Project Chat
                    </a>
                    <a asp-controller="Admin" asp-action="EditProject" asp-route-id="@Model.Id" class="btn btn-outline-warning">
                        Edit Project
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>