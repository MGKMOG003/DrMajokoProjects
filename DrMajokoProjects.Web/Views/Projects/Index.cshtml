@model List<DrMajokoProjects.Web.Models.ViewModels.ProjectViewModel>

@{
    ViewData["Title"] = "Projects";
}

<div class="row mb-3">
    <div class="col">
        <h2>Projects</h2>
    </div>
    <div class="col text-end">
        <a asp-action="Create" class="btn btn-primary">Create New Project</a>
    </div>
</div>

<div class="row">
    @if (Model.Any())
    {
        @foreach (var project in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@project.Name</h5>
                        <p class="card-text">@project.Description</p>
                        <div class="mb-2">
                            <span class="badge bg-@(project.Status == "Completed" ? "success" : "warning")">
                                @project.Status
                            </span>
                        </div>
                        <p class="card-text">
                            <small class="text-muted">
                                Budget: R @project.Budget.ToString("N2")<br />
                                Spent: R @project.ActualSpent.ToString("N2")
                            </small>
                        </p>
                        <a asp-action="Details" asp-route-id="@project.Id" class="btn btn-sm btn-outline-primary">View Details</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info">No projects found. Create one to get started!</div>
        </div>
    }
</div>